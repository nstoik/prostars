# Copy this file to .env and fill in values for local development.
# Never commit .env to source control.

# Paste the full contents of your Google service account JSON as a single line.
# IMPORTANT: Rotate the old key at https://console.cloud.google.com before deploying.
GOOGLE_CREDENTIALS='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'

# Flask secret key — use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# Optional: override the default port (default 5000)
# PORT=5000
