{
	"name": "Prostars",
	"dockerFile": "./devcontainer.Dockerfile",

	"mounts": [
		"source=prostars-bashhistory,target=/commandhistory,type=volume"
	],

	"workspaceFolder": "/workspaces/prostars",
	"shutdownAction": "stopContainer",
	"runArgs": [
		"--name", "prostars-devcontainer"
	],

	"postCreateCommand": "git config --global user.email 'nelsonstoik@gmail.com' && git config --global user.name 'Nelson' && UV_LINK_MODE=copy uv sync",

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"eamodio.gitlens",
				"ms-python.vscode-pylance",
				"anthropic.claude-code"
			],
			"settings": {
				"python.defaultInterpreterPath": "/workspaces/prostars/.venv/bin/python"
			}
		}
	}
}
